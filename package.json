{
  "name": "iris-app",
  "productName": "Iris",
  "version": "0.1.0-beta.9",
  "private": true,
  "description": "Iris — AI-native, document-centric, terminal-driven project management. The app is a reference implementation of the .iris/ protocol.",
  "author": {
    "name": "程璃月",
    "email": "liyue_cheng@163.com",
    "url": "https://github.com/Liyue-Cheng"
  },
  "copyright": "Copyright (c) 2026 程璃月",
  "homepage": "https://github.com/Liyue-Cheng/iris#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liyue-Cheng/iris.git"
  },
  "bugs": {
    "url": "https://github.com/Liyue-Cheng/iris/issues"
  },
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json && npm run check:async",
    "check:async": "node scripts/check-async-boundaries.mjs",
    "smoke": "node scripts/smoke-launch.mjs",
    "metadata:check": "node scripts/check-product-metadata.mjs",
    "agent:worker-check": "node scripts/check-agent-worker.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:lucide-icon-names": "node scripts/generate-lucide-icon-names.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && npm run metadata:check && npm run licenses:check && node scripts/clean-release.mjs && electron-builder --win --x64"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@xterm/addon-search": "^0.17.0-beta.256",
    "@xterm/addon-serialize": "^0.15.0-beta.256",
    "@xterm/headless": "^6.1.0-beta.256",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "i18next": "^26.3.6",
    "node-pty": "^1.1.0",
    "react-i18next": "^17.0.11",
    "typebox": "1.3.7",
    "undici": "^6.26.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@radix-ui/react-context-menu": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "24.13.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.12.0-beta.256",
    "@xterm/addon-web-links": "^0.13.0-beta.256",
    "@xterm/addon-webgl": "^0.20.0-beta.255",
    "@xterm/xterm": "^6.1.0-beta.256",
    "autoprefixer": "^10.4.19",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "electron": "43.4.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^2.2.0",
    "front-cpu": "^0.3.0",
    "js-yaml": "^4.3.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.16.1",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.1"
  }
}
